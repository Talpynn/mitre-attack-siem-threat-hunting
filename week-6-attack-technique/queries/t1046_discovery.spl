| inputlookup network_connections.csv
| eval _time=strptime(_time, "%Y-%m-%dT%H:%M:%S")
| where scenario="simulated_discovery"
| stats count AS connection_attempts dc(dest_port) AS unique_ports values(dest_port) AS ports values(action) AS observed_actions by src_ip dest_ip
| where unique_ports >= 10
| sort - unique_ports
