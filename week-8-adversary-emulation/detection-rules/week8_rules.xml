<!-- Lab signatures, not general maliciousness classifiers. Check IDs are unused.
     Replace default username and RFC1918 addresses to match your lab. -->
<group name="week8_lab,">
  <rule id="100810" level="5">
    <if_group>windows</if_group>
    <field name="win.system.channel">^Security$</field>
    <field name="win.system.eventID">^4624$</field>
    <field name="win.eventdata.targetUserName" type="pcre2">(?i)^labstudent$</field>
    <field name="win.eventdata.logonType">^10$</field>
    <field name="win.eventdata.ipAddress">^192\.168\.56\.20$</field>
    <description>Week8 lab account remote interactive logon from designated source</description>
    <mitre><id>T1078</id></mitre>
  </rule>
  <rule id="100811" level="7">
    <if_group>windows</if_group>
    <field name="win.system.channel">^Security$</field>
    <field name="win.system.eventID">^4698$</field>
    <field name="win.eventdata.taskName" type="pcre2">(?i)^\\Lab_Emulation_Test$</field>
    <description>Week8 lab scheduled task created</description>
    <mitre><id>T1053.005</id></mitre>
  </rule>
  <rule id="100812" level="5">
    <if_group>windows</if_group>
    <field name="win.system.channel">^Microsoft-Windows-Sysmon/Operational$</field>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\curl\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)dummy-data\.txt</field>
    <description>Week8 dummy file upload command observed evidence of attempt only</description>
    <mitre><id>T1048.003</id></mitre>
  </rule>
  <rule id="100813" level="7">
    <if_group>windows</if_group>
    <field name="win.system.channel">^Microsoft-Windows-Sysmon/Operational$</field>
    <field name="win.system.eventID">^3$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\curl\.exe$</field>
    <field name="win.eventdata.destinationIp">^192\.168\.56\.20$</field>
    <field name="win.eventdata.destinationPort">^8080$</field>
    <description>Week8 curl connection to lab receiver corroborate with receiver hash</description>
    <mitre><id>T1048.003</id></mitre>
  </rule>
</group>
