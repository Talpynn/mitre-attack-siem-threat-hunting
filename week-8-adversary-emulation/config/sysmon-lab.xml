<!-- Fresh isolated lab only. Merge with an existing configuration instead of replacing it.
     Check the supported schema with Sysmon64.exe -s before applying. -->
<Sysmon schemaversion="4.90">
  <HashAlgorithms>sha256</HashAlgorithms>
  <EventFiltering>
    <ProcessCreate onmatch="include">
      <Image condition="end with">\curl.exe</Image>
      <Image condition="end with">\powershell.exe</Image>
    </ProcessCreate>
    <NetworkConnect onmatch="include">
      <Image condition="end with">\curl.exe</Image>
    </NetworkConnect>
  </EventFiltering>
</Sysmon>
